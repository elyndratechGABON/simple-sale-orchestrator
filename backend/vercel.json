{
  "builds": [
    { "src": "api/index.mjs", "use": "@vercel/node", "config": { "maxDuration": 60 } },
    { "src": "api-dashboard/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "src": "/assets/(.*)", "dest": "/api-dashboard/assets/$1" },
    { "src": "/(.*)", "dest": "/api-dashboard/index.html" }
  ],
  "crons": [
    { "path": "/api/v1/drain", "schedule": "0 2 * * *" }
  ]
}
