node_modules/
dist/
# Le Control Center est servi par backend/app.mjs (express.static sur dashboard/dist).
# Vercel ne construit pas le dashboard : sans ces fichiers en versionne, le
# tableau de bord est un 404 alors que l'API, elle, repond. 3 fichiers, 260 Ko.
!dashboard/dist/
!dashboard/dist/**
# Copie du build consommée par @vercel/static (backend/vercel.json) : la fonction
# serverless n'upload PAS les fichiers hors de son dossier projet, d'où cette copie.
!backend/api-dashboard/
!backend/api-dashboard/**
.output/
.wrangler/
# `.env` seul ne couvrait pas `.env.local` ni `.env.production`, et c'est
# justement la que `vercel --prod` ecrit un VERCEL_OIDC_TOKEN. Le motif sans
# slash couvre deja n'importe quel niveau, donc backend/ et relay/ sont inclus.
.env*
!.env.example
bun.lock
orchestrator/data/
*.log
pnpm-lock.yaml
backend/.test_*
.vercel
