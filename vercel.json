{
  "builds": [
    { "src": "backend/api/index.mjs", "use": "@vercel/node", "config": { "maxDuration": 60 } },
    { "src": "backend/api-dashboard/**", "use": "@vercel/static" }
  ],
  "regions": ["cle1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.mjs" },
    { "src": "/assets/(.*)", "dest": "/backend/api-dashboard/assets/$1" },
    { "src": "/(.*)", "dest": "/backend/api-dashboard/index.html" }
  ],
  "crons": [
    { "path": "/api/v1/drain", "schedule": "0 2 * * *" }
  ]
}
